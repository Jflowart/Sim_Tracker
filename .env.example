# Copy this file to .env and fill in your own values.
# Optional: create a key at https://opencagedata.com/ and never commit it.
OPENCAGE_API_KEY=

# Geocoding provider: auto | opencage | nominatim | off
# auto = OpenCage when a key is set, otherwise keyless OpenStreetMap Nominatim.
GEOCODER=auto

# Nominatim asks apps to identify themselves. Add your email if you use it heavily.
GEOCODER_USER_AGENT=simtracker-osint/2.0
NOMINATIM_EMAIL=
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Optional: default region for numbers entered without a country code (ISO 3166-1 alpha-2).
DEFAULT_REGION=

# Optional: where cache, audit log, history and maps are stored.
# TRACKER_DATA_DIR=data

# Optional: geocode cache lifetime in hours (default 720 = 30 days).
CACHE_TTL_HOURS=720

# Deprecated alias, still read if GEOCODER_USER_AGENT is not set.
# OPENCAGE_USER_AGENT=simtracker-osint

# Optional: batch upload limits and retention.
BATCH_MAX_ROWS=2000
BATCH_RETENTION_DAYS=30

# Optional: Flask dashboard host/port. Keep 127.0.0.1 unless you add authentication.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional: stable session secret. Otherwise one is generated in data/.secret_key.
# FLASK_SECRET_KEY=
